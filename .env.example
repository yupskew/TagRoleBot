# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Client ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=

# The ID of your Discord server (right-click server → Copy Server ID)
GUILD_ID=

# The role ID to assign/remove based on server tag (right-click role → Copy Role ID)
TAG_ROLE_ID=

# Optional: How often (in ms) to run background sync (default: 1 hour)
# SYNC_INTERVAL_MS=3600000

# Optional: Log level (debug, info, warn, error) (default: info)
# LOG_LEVEL=info
